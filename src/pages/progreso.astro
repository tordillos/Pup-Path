---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { phases } from '../data/phases';
import { tasksByPhase } from '../data/tasks';

const categories = [
  { id: 'fundamento', label: 'Fundamentos', icon: 'paw' as const },
  { id: 'obediencia', label: 'Órdenes', icon: 'sit' as const },
  { id: 'habito', label: 'Hábitos', icon: 'bed' as const },
  { id: 'truco', label: 'Trucos', icon: 'star' as const },
  { id: 'mental', label: 'Trabajo mental', icon: 'brain' as const },
  { id: 'deporte', label: 'Deporte', icon: 'trophy' as const },
];
---

<BaseLayout title="Progreso">
  <div class="container page">
    <header class="page-head">
      <h1>Tu progreso</h1>
      <p class="muted">Todo lo que has registrado, por fase y por tipo de tarea.</p>
    </header>

    <!-- Spinner de carga -->
    <div id="progreso-spinner" class="page-loader">
      <div class="spinner"></div>
      <p class="small muted">Cargando progreso...</p>
    </div>

    <!-- Estado cuando NO hay mascota activa -->
    <div id="progreso-no-pet-card" class="card empty" style="text-align: center; padding: var(--space-m);" hidden>
      <p class="lead" style="margin-bottom: var(--space-2xs);">🐾 No tienes ninguna mascota activa</p>
      <p class="small muted" style="margin-bottom: var(--space-s);">Para registrar sesiones y ver estadísticas de progreso, añade una mascota en Ajustes o únete a una compartida.</p>
      <a href="/ajustes" class="btn btn--primary">Gestionar mascotas en Ajustes</a>
    </div>

    <!-- Contenido de progreso -->
    <div id="progreso-content" hidden>
      <p class="empty card" data-empty hidden>
        Todavía no has registrado ninguna sesión para <strong id="progreso-dog-name">tu mascota</strong>. Empieza por el
        <a href="/timeline">timeline</a> o por la sugerencia de <a href="/">hoy</a>.
      </p>

      <section class="grid-auto stats">
        <article class="card stat"><strong data-stat="percent">0%</strong><span class="small muted">del plan completado</span></article>
        <article class="card stat"><strong data-stat="dominados">0</strong><span class="small muted">tareas dominadas</span></article>
        <article class="card stat"><strong data-stat="progreso">0</strong><span class="small muted">tareas en progreso</span></article>
        <article class="card stat"><strong data-stat="sesiones">0</strong><span class="small muted">sesiones registradas</span></article>
      </section>

      <section class="ring-block card">
        <svg class="ring" viewBox="0 0 120 120" role="img" aria-label="Progreso general">
          <circle class="ring__track" cx="60" cy="60" r="52" />
          <circle class="ring__value" cx="60" cy="60" r="52" data-ring />
          <text class="ring__text" x="60" y="60" dominant-baseline="middle" text-anchor="middle" data-ring-text>0%</text>
        </svg>
        <div>
          <h2 class="small muted">Fase actual</h2>
          <p class="ring-phase" data-current-phase>Fase 1 · Fundamentos</p>
          <p class="small muted" data-current-next>Empieza por responder a su nombre.</p>
        </div>
      </section>

      <section class="block">
        <h2><Icon name="clock" size={20} /> Días entrenados</h2>

        <div class="cal-streaks">
          <article class="card cal-streak cal-streak--current">
            <span class="cal-streak__emoji" aria-hidden="true">🔥</span>
            <strong data-streak-current>0</strong>
            <span class="small muted">racha actual</span>
          </article>
          <article class="card cal-streak">
            <span class="cal-streak__emoji" aria-hidden="true">🏆</span>
            <strong data-streak-best>0</strong>
            <span class="small muted">mejor racha</span>
          </article>
          <article class="card cal-streak">
            <span class="cal-streak__emoji" aria-hidden="true">📅</span>
            <strong data-total-days>0</strong>
            <span class="small muted">días entrenados</span>
          </article>
          <article class="card cal-streak">
            <span class="cal-streak__emoji" aria-hidden="true">🐾</span>
            <strong data-total-sessions>0</strong>
            <span class="small muted">sesiones</span>
          </article>
        </div>

        <p class="small muted cal-note" data-cal-empty hidden>
          Todavía no hay ningún día marcado. Registra una sesión desde la ficha de cualquier tarea y aparecerá aquí.
        </p>

        <div class="cal-months" data-months></div>

        <p class="cal-legend small muted" data-cal-legend hidden>
          <span>Menos</span>
          <span class="cal-legend__cell" data-level="0"></span>
          <span class="cal-legend__cell" data-level="1"></span>
          <span class="cal-legend__cell" data-level="2"></span>
          <span class="cal-legend__cell" data-level="3"></span>
          <span>Más</span>
        </p>
      </section>

      <section class="block">
        <h2><Icon name="flag" size={20} /> Por fase</h2>
        <ul class="bars">
          {phases.map((phase) => (
            <li style={`--phase:${phase.color}`} data-phase-row={phase.id}>
              <span class="bars__icon"><Icon name={phase.icon} size={18} /></span>
              <span class="bars__label">{phase.title}</span>
              <span class="bars__track"><span class="bars__bar" data-bar style="width:0%"></span></span>
              <span class="small muted bars__count"><span data-done>0</span>/{tasksByPhase(phase.id).length}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="block">
        <h2><Icon name="chart" size={20} /> Por tipo de tarea</h2>
        <ul class="bars">
          {categories.map((cat) => (
            <li style="--phase: var(--accent)" data-cat-row={cat.id}>
              <span class="bars__icon"><Icon name={cat.icon} size={18} /></span>
              <span class="bars__label">{cat.label}</span>
              <span class="bars__track"><span class="bars__bar" data-bar style="width:0%"></span></span>
              <span class="small muted bars__count"><span data-done>0</span>/<span data-total>0</span></span>
            </li>
          ))}
        </ul>
      </section>

      <section class="block">
        <h2><Icon name="clock" size={20} /> Últimas actualizaciones</h2>
        <ul class="recent" data-recent>
          <li class="muted small">Nada registrado todavía.</li>
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  import { load, ensureProgressLoaded, getActiveDogId, TRAINING_DAYS_EVENT } from '../scripts/progress';
  import { getTrainingHistory, toLocalDayKey } from '../scripts/sync';
  import { stateOf, stats } from '../scripts/engine';
  import { orderedTasks, tasks, tasksByPhase } from '../data/tasks';
  import { phaseById, phases } from '../data/phases';
  import { icon, onProgressChange } from '../scripts/ui';
  import { getCurrentUser } from '../scripts/auth';
  import type { Category } from '../data/types';

  const fmt = new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'short' });
  const STATE_LABEL = { dominado: 'Dominado', progreso: 'En progreso', disponible: 'Disponible', bloqueada: 'Bloqueada' };
  const CIRCUMFERENCE = 2 * Math.PI * 52;

  function paint() {
    const progress = load();
    const dogNameEl = document.getElementById('progreso-dog-name');
    if (dogNameEl && progress.dogName) dogNameEl.textContent = progress.dogName;

    const s = stats(progress);

    const empty = document.querySelector<HTMLElement>('[data-empty]');
    if (empty) {
      empty.hidden = s.sesiones > 0 || s.dominados > 0;
    }

    const set = (key: string, value: string) => {
      const el = document.querySelector(`[data-stat="${key}"]`);
      if (el) el.textContent = value;
    };
    set('percent', `${s.percent}%`);
    set('dominados', String(s.dominados));
    set('progreso', String(s.enProgreso));
    set('sesiones', String(s.sesiones));

    const ring = document.querySelector<SVGCircleElement>('[data-ring]');
    if (ring) {
      ring.style.strokeDasharray = String(CIRCUMFERENCE);
      ring.style.strokeDashoffset = String(CIRCUMFERENCE * (1 - s.percent / 100));
    }
    const ringText = document.querySelector('[data-ring-text]');
    if (ringText) ringText.textContent = `${s.percent}%`;

    const phase = phaseById(s.fase);
    const phaseEl = document.querySelector('[data-current-phase]');
    if (phaseEl) phaseEl.textContent = `Fase ${phase.id} · ${phase.title}`;

    const nextTask = orderedTasks.find((t) => progress.tasks[t.id]?.status !== 'dominado');
    const nextEl = document.querySelector('[data-current-next]');
    if (nextEl) nextEl.textContent = nextTask ? `Siguiente: ${nextTask.title}` : 'Plan completado.';

    for (const p of phases) {
      const row = document.querySelector<HTMLElement>(`[data-phase-row="${p.id}"]`);
      if (!row) continue;
      const list = tasksByPhase(p.id);
      const done = list.filter((t) => stateOf(t, progress) === 'dominado').length;
      row.querySelector<HTMLElement>('[data-bar]')!.style.width = `${Math.round((done / list.length) * 100)}%`;
      row.querySelector('[data-done]')!.textContent = String(done);
    }

    const catTotals: Record<Category, number> = { fundamento: 0, obediencia: 0, habito: 0, truco: 0, mental: 0, deporte: 0 };
    const catDone: Record<Category, number> = { fundamento: 0, obediencia: 0, habito: 0, truco: 0, mental: 0, deporte: 0 };
    for (const t of tasks) {
      catTotals[t.category]++;
      if (stateOf(t, progress) === 'dominado') catDone[t.category]++;
    }
    document.querySelectorAll<HTMLElement>('[data-cat-row]').forEach((row) => {
      const cat = row.dataset.catRow as Category;
      const total = catTotals[cat];
      const done = catDone[cat];
      const pct = total === 0 ? 0 : Math.round((done / total) * 100);
      row.querySelector<HTMLElement>('[data-bar]')!.style.width = `${pct}%`;
      row.querySelector('[data-done]')!.textContent = String(done);
      row.querySelector('[data-total]')!.textContent = String(total);
    });

    const recentEl = document.querySelector<HTMLElement>('[data-recent]');
    if (recentEl) {
      const entries = Object.entries(progress.tasks)
        .filter(([, v]) => v.updatedAt)
        .sort((a, b) => new Date(b[1].updatedAt).getTime() - new Date(a[1].updatedAt).getTime())
        .slice(0, 5);

      if (entries.length === 0) {
        recentEl.innerHTML = '<li class="muted small">Nada registrado todavía.</li>';
      } else {
        recentEl.innerHTML = entries
          .map(([id, entry]) => {
            const task = tasks.find((t) => t.id === id);
            if (!task) return '';
            const state = stateOf(task, progress);
            return `
              <li class="recent__item">
                <span class="icon-tile icon-tile--sm">${icon(task.icon, 16)}</span>
                <span class="recent__title"><a href="/tarea/${task.id}">${task.title}</a></span>
                <span class="badge">${STATE_LABEL[state]}</span>
                <time class="small muted" datetime="${entry.updatedAt}">${fmt.format(new Date(entry.updatedAt))}</time>
              </li>`;
          })
          .join('');
      }
    }
  }

  const MESES = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
  // La semana empieza en lunes, como los calendarios de aquí.
  const DIAS = ['L', 'M', 'X', 'J', 'V', 'S', 'D'];

  function nivel(sesiones: number): number {
    if (sesiones <= 0) return 0;
    if (sesiones === 1) return 1;
    if (sesiones <= 3) return 2;
    return 3;
  }

  /** Días consecutivos con sesión terminando hoy (o ayer: hoy aún da tiempo). */
  function rachaActual(days: Record<string, number>): number {
    const cursor = new Date();
    if (!days[toLocalDayKey(cursor)]) {
      cursor.setDate(cursor.getDate() - 1);
      if (!days[toLocalDayKey(cursor)]) return 0;
    }
    let racha = 0;
    while (days[toLocalDayKey(cursor)]) {
      racha++;
      cursor.setDate(cursor.getDate() - 1);
    }
    return racha;
  }

  function mejorRacha(days: Record<string, number>): number {
    let mejor = 0;
    let actual = 0;
    let anterior: Date | null = null;

    for (const clave of Object.keys(days).sort()) {
      const [y, m, d] = clave.split('-').map(Number);
      const fecha = new Date(y, m - 1, d);
      if (anterior) {
        const diff = Math.round((fecha.getTime() - anterior.getTime()) / 86400000);
        actual = diff === 1 ? actual + 1 : 1;
      } else {
        actual = 1;
      }
      mejor = Math.max(mejor, actual);
      anterior = fecha;
    }
    return mejor;
  }

  function pintarMes(anio: number, mes: number, days: Record<string, number>, inicio: string, hoy: string): string {
    const totalDias = new Date(anio, mes + 1, 0).getDate();
    // getDay() da 0 para domingo; se desplaza para que la rejilla empiece en lunes.
    const hueco = (new Date(anio, mes, 1).getDay() + 6) % 7;

    const celdas: string[] = [];
    for (let i = 0; i < hueco; i++) celdas.push('<span class="cal-day cal-day--empty"></span>');

    for (let d = 1; d <= totalDias; d++) {
      const clave = `${anio}-${String(mes + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
      const sesiones = days[clave] || 0;
      const clases = ['cal-day'];
      if (clave === hoy) clases.push('cal-day--today');
      if (clave === inicio) clases.push('cal-day--start');
      if (clave > hoy) clases.push('cal-day--future');

      const etiqueta = sesiones
        ? `${d} de ${MESES[mes]}: ${sesiones} ${sesiones === 1 ? 'sesión' : 'sesiones'}`
        : `${d} de ${MESES[mes]}: sin entrenar`;

      celdas.push(`<span class="${clases.join(' ')}" data-level="${nivel(sesiones)}" title="${etiqueta}">${d}</span>`);
    }

    return `
      <article class="card cal-month">
        <h3 class="cal-month__title">${MESES[mes]} <span class="muted">${anio}</span></h3>
        <div class="cal-weekdays" aria-hidden="true">${DIAS.map((d) => `<span>${d}</span>`).join('')}</div>
        <div class="cal-days">${celdas.join('')}</div>
      </article>`;
  }

  async function pintarCalendario() {
    const contenedor = document.querySelector<HTMLElement>('[data-months]');
    const vacio = document.querySelector<HTMLElement>('[data-cal-empty]');
    const leyenda = document.querySelector<HTMLElement>('[data-cal-legend]');
    const dogId = getActiveDogId();
    if (!contenedor || !dogId) return;

    const { days, startedAt } = await getTrainingHistory(dogId);
    const hoy = toLocalDayKey(new Date());
    const inicio = startedAt || hoy;

    const totalDias = Object.keys(days).length;
    const totalSesiones = Object.values(days).reduce((a, b) => a + b, 0);

    const set = (sel: string, valor: number) => {
      const el = document.querySelector(sel);
      if (el) el.textContent = String(valor);
    };
    set('[data-streak-current]', rachaActual(days));
    set('[data-streak-best]', mejorRacha(days));
    set('[data-total-days]', totalDias);
    set('[data-total-sessions]', totalSesiones);

    if (vacio) vacio.hidden = totalDias > 0;
    if (leyenda) leyenda.hidden = totalDias === 0;

    // Del alta de la mascota al mes actual, sin huecos y con el mes en curso
    // primero, que es el que se mira.
    const [ay, am] = inicio.split('-').map(Number);
    const ahora = new Date();
    const meses: string[] = [];
    const cursor = new Date(ay, am - 1, 1);
    while (cursor <= ahora) {
      meses.push(pintarMes(cursor.getFullYear(), cursor.getMonth(), days, inicio, hoy));
      cursor.setMonth(cursor.getMonth() + 1);
    }
    contenedor.innerHTML = meses.reverse().join('');
  }

  async function initProgreso() {
    const spinner = document.getElementById('progreso-spinner');
    const noPetCard = document.getElementById('progreso-no-pet-card');
    const progresoContent = document.getElementById('progreso-content');

    const user = await getCurrentUser();
    if (!user) {
      window.location.href = '/login?redirect=/progreso';
      return;
    }

    if (spinner) spinner.hidden = false;
    const progress = await ensureProgressLoaded();
    if (spinner) spinner.hidden = true;

    if (!progress.dogName) {
      if (noPetCard) noPetCard.hidden = false;
      if (progresoContent) progresoContent.hidden = true;
      return;
    }

    if (noPetCard) noPetCard.hidden = true;
    if (progresoContent) progresoContent.hidden = false;

    paint();
    pintarCalendario();
  }

  document.addEventListener('astro:page-load', initProgreso);
  document.addEventListener(TRAINING_DAYS_EVENT, pintarCalendario);
  onProgressChange(paint);
</script>

<style>
  .page { padding-block: var(--space-l); }
  .page-head { margin-block-end: var(--space-m); }

  .empty { margin-block-end: var(--space-m); }

  .stats { margin-block-end: var(--space-m); }
  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-3xs);
    padding: var(--space-m);
  }
  .stat strong { font-size: var(--step-3); line-height: 1; color: var(--accent); }

  .ring-block {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    padding: var(--space-m);
    margin-block-end: var(--space-m);
  }
  .ring { width: 96px; height: 96px; transform: rotate(-90deg); flex-shrink: 0; }
  .ring__track {
    fill: none;
    stroke: var(--bg-sunken);
    stroke-width: 10;
  }
  .ring__value {
    fill: none;
    stroke: var(--accent);
    stroke-width: 10;
    stroke-linecap: round;
    transition: stroke-dashoffset 0.4s var(--ease);
  }
  .ring__text {
    transform: rotate(90deg);
    transform-origin: 60px 60px;
    font-size: 1.3rem;
    font-weight: 700;
    fill: var(--text);
  }
  .ring-phase { font-size: var(--step-1); font-weight: 700; }

  .block + .block { margin-block-start: var(--space-m); }
  .block h2 {
    display: flex;
    align-items: center;
    gap: 0.4em;
    font-size: var(--step-0);
    margin-block-end: var(--space-xs);
  }

  .bars { display: grid; gap: var(--space-2xs); list-style: none; padding: 0; }
  .bars li {
    display: grid;
    grid-template-columns: 1.5rem minmax(7rem, 11rem) 1fr auto;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-2xs) var(--space-xs);
    border-radius: var(--radius-s);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
  }
  .bars__icon { display: grid; place-items: center; color: var(--phase); }
  .bars__label { font-weight: 600; font-size: var(--step--1); }
  .bars__track {
    height: 8px;
    background: var(--bg-sunken);
    border-radius: var(--radius-full);
    overflow: hidden;
  }
  .bars__bar {
    display: block;
    height: 100%;
    background: var(--phase);
    border-radius: var(--radius-full);
    transition: width 0.3s var(--ease);
  }
  .bars__count { font-variant-numeric: tabular-nums; }

  .recent { display: grid; gap: var(--space-3xs); list-style: none; padding: 0; }
  .recent__item {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-2xs) var(--space-xs);
    border-radius: var(--radius-s);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
  }
  .recent__title { font-weight: 600; font-size: var(--step--1); }
  .recent__title a { text-decoration: none; }
  .recent__title a:hover { text-decoration: underline; }

  @media (max-width: 39.99rem) {
    .bars li {
      grid-template-columns: 1.5rem 1fr auto;
      grid-template-rows: auto auto;
    }
    .bars__track {
      grid-column: 1 / -1;
    }
  }
</style>

<style is:global>
  /* Global y no con ámbito: las rejillas del calendario las escribe el script
     con innerHTML, y a ese HTML no le llega el atributo de ámbito de Astro. */
  .cal-streaks {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-xs);
    margin-block-end: var(--space-s);
  }
  @media (min-width: 40rem) {
    .cal-streaks { grid-template-columns: repeat(4, 1fr); }
  }
  .cal-streak {
    display: grid;
    justify-items: center;
    gap: 2px;
    text-align: center;
    padding: var(--space-s) var(--space-2xs);
  }
  .cal-streak strong { font-size: var(--step-2); line-height: 1; font-variant-numeric: tabular-nums; }
  .cal-streak__emoji { font-size: 1.25rem; line-height: 1; }
  .cal-streak--current { border-color: var(--accent); background: var(--accent-soft); }
  .cal-streak--current strong { color: var(--accent); }

  .cal-note { margin-block-end: var(--space-s); }

  .cal-months {
    display: grid;
    gap: var(--space-s);
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
  }

  .cal-month { display: grid; gap: var(--space-2xs); padding: var(--space-s); }
  .cal-month__title { font-size: var(--step-0); margin: 0; }

  .cal-weekdays,
  .cal-days {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 4px;
  }
  .cal-weekdays {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--text-muted);
    text-align: center;
  }

  .cal-day {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    border-radius: var(--radius-s);
    background: var(--bg-sunken);
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
    color: var(--text-muted);
  }
  .cal-day--empty { background: none; }
  .cal-day--future { opacity: 0.35; }

  /* Escala de intensidad: cuantas más sesiones ese día, más sólido el verde. */
  .cal-day[data-level='1'] { background: color-mix(in srgb, var(--accent) 32%, var(--bg-sunken)); color: var(--text); }
  .cal-day[data-level='2'] { background: color-mix(in srgb, var(--accent) 65%, var(--bg-sunken)); color: #fff; }
  .cal-day[data-level='3'] { background: var(--accent); color: #fff; font-weight: 700; }

  .cal-day--today { outline: 2px solid var(--text); outline-offset: 1px; }
  /* El día en que empezó todo */
  .cal-day--start { box-shadow: inset 0 0 0 2px var(--warn); }

  .cal-legend {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 6px;
    margin-block-start: var(--space-s);
  }
  .cal-legend__cell {
    width: 14px;
    height: 14px;
    border-radius: 4px;
    background: var(--bg-sunken);
