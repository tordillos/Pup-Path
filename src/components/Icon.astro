---
import type { IconName } from '../data/types';
import { iconPaths } from '../data/icons';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 24, class: className = '' } = Astro.props;

---

<svg
  class={`icon ${className}`}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={iconPaths[name]}
/>
