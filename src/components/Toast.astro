---

<div id="toast-container" class="toast-container" aria-live="polite" aria-atomic="true"></div>

<script>
  import { TOAST_EVENT, type ToastDetail } from '../scripts/toast';

  const container = document.getElementById('toast-container');

  const icons: Record<string, string> = {
    error: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>`,
    success: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>`,
    warning: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>`,
    info: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>`,
  };

  document.addEventListener(TOAST_EVENT, (event: any) => {
    if (!container) return;
    const { id, message, type, duration } = event.detail as ToastDetail;

    const toast = document.createElement('div');
    toast.className = `toast toast--${type}`;
    toast.dataset.id = id;
    toast.setAttribute('role', type === 'error' ? 'alert' : 'status');

    toast.innerHTML = `
      <div class="toast__icon">${icons[type] || icons.info}</div>
      <div class="toast__message">${escapeHtml(message)}</div>
      <button class="toast__close" aria-label="Cerrar notificación">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    `;

    const closeBtn = toast.querySelector('.toast__close');
    let timer: number | undefined;

    const dismiss = () => {
      window.clearTimeout(timer);
      toast.classList.add('toast--exit');
      toast.addEventListener('animationend', () => toast.remove());
    };

    closeBtn?.addEventListener('click', dismiss);

    if (duration > 0) {
      timer = window.setTimeout(dismiss, duration);
    }

    container.appendChild(toast);
  });

  function escapeHtml(str: string): string {
    const p = document.createElement('p');
    p.textContent = str;
    return p.innerHTML;
  }
</script>

<style is:global>
  .toast-container {
    position: fixed;
    top: 1rem;
    right: 1rem;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: min(calc(100vw - 2rem), 400px);
    pointer-events: none;
  }

  @media (max-width: 48rem) {
    .toast-container {
      top: auto;
      bottom: 5rem; /* Encima de la tabbar en móvil */
      left: 1rem;
      right: 1rem;
      max-width: none;
    }
  }

  .toast {
    pointer-events: auto;
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    border-radius: var(--radius-s);
    background: var(--bg-elevated);
    color: var(--text);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25), 0 2px 6px rgba(0, 0, 0, 0.1);
    border: 1px solid var(--border);
    animation: toast-in 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    font-size: var(--step--1);
    line-height: 1.4;
  }

  .toast--exit {
    animation: toast-out 0.2s ease forwards;
  }

  .toast__icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .toast__message {
    flex: 1;
    word-break: break-word;
    font-weight: 500;
  }

  .toast__close {
    background: transparent;
    border: 0;
    padding: 0.2rem;
    color: var(--text-muted);
    cursor: pointer;
    display: grid;
    place-items: center;
    border-radius: var(--radius-full);
    transition: color 0.15s ease, background-color 0.15s ease;
  }
  .toast__close:hover {
    color: var(--text);
    background: var(--bg-sunken);
  }

  /* Variantes de tipo */
  .toast--error {
    border-color: color-mix(in srgb, var(--warn) 60%, var(--border));
    background: color-mix(in srgb, var(--bg-elevated) 92%, var(--warn));
    color: var(--text);
  }
  .toast--error .toast__icon {
    color: var(--warn);
  }

  .toast--success {
    border-color: color-mix(in srgb, #22c55e 60%, var(--border));
    background: color-mix(in srgb, var(--bg-elevated) 92%, #22c55e);
  }
  .toast--success .toast__icon {
    color: #22c55e;
  }

  .toast--warning {
    border-color: color-mix(in srgb, #f59e0b 60%, var(--border));
    background: color-mix(in srgb, var(--bg-elevated) 92%, #f59e0b);
  }
  .toast--warning .toast__icon {
    color: #f59e0b;
  }

  .toast--info {
    border-color: color-mix(in srgb, var(--accent) 50%, var(--border));
    background: color-mix(in srgb, var(--bg-elevated) 94%, var(--accent));
  }
  .toast--info .toast__icon {
    color: var(--accent);
  }

  @keyframes toast-in {
    from {
      opacity: 0;
      transform: translateY(-10px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes toast-out {
    from {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
    to {
      opacity: 0;
      transform: translateY(-8px) scale(0.96);
    }
  }
</style>
