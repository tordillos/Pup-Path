# ==========================================
# BASE DE DATOS (Drizzle ORM & Migraciones)
# ==========================================
# Cadena de conexión directa o con pooler a PostgreSQL (Supabase)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ==========================================
# AUTENTICACIÓN & CLIENTE SUPABASE (Frontend)
# ==========================================
PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"

# Nueva Publishable Key de Supabase (empieza por sb_pu_...)
PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_pu_..."

# (Opcional) Si usas keys legacy tipo JWT:
# PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
